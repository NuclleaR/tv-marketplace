default:
    @just --list

# >>> android:just — emulator recipes, regenerated by /android:just >>>
_android_agent := ".claude/android"

# Start the emulator in a window, install the debug app and open it
run:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    install_task="$(python3 -c 'import json,pathlib; p=pathlib.Path(".claude/android.json"); print((json.loads(p.read_text()) if p.is_file() else {}).get("installTask", ":app:installDebug"))')"
    ./gradlew "$install_task"
    python3 {{_android_agent}}/ui.py launch

# Start the emulator in a window (or reuse it) and print its ANDROID_SERIAL
emulator:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"

# Build and install the debug app on the emulator
install:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    install_task="$(python3 -c 'import json,pathlib; p=pathlib.Path(".claude/android.json"); print((json.loads(p.read_text()) if p.is_file() else {}).get("installTask", ":app:installDebug"))')"
    ./gradlew "$install_task"

# Restart the app on the emulator
launch:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py launch

# Drive the screen: just ui dump | tap "Settings" | wait X | type X | scroll down | deeplink URI
[positional-arguments]
ui *args:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py "$@"

# Save a screenshot of the emulator and print its path
screenshot path='':
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py screenshot --full {{path}}

# The app's recent logcat
logs:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py logs

# The emulator's crash buffer
crash:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py logs --crash

# Dark mode on the emulator: just dark, just dark no
dark on='yes':
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py adb shell cmd uimode night {{on}}

# Font scale on the emulator: just font-scale 2.0
font-scale scale='1.0':
    #!/usr/bin/env bash
    set -euo pipefail
    export ANDROID_SERIAL="$(python3 {{_android_agent}}/emulator.py start --name just --window | tee /dev/stderr | sed -n 's/^ANDROID_SERIAL=//p')"
    python3 {{_android_agent}}/ui.py adb shell settings put system font_scale {{scale}}

# List the agent emulators and the base AVD
emulators:
    python3 {{_android_agent}}/emulator.py list

# Rebuild the base AVD with the current app (stop the emulators first)
emulator-prepare:
    python3 {{_android_agent}}/emulator.py prepare

# Stop the emulator that just started
emulator-stop:
    python3 {{_android_agent}}/emulator.py stop --name just

# Stop the emulator that just started and the Gradle daemons
stop:
    #!/usr/bin/env bash
    set -euo pipefail
    python3 {{_android_agent}}/emulator.py stop --name just
    ./gradlew --stop

