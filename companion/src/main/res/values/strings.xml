<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Name of the phone companion app -->
  <string name="companion_name">Send to TV</string>
  <!-- Label of the app in the system Share menu -->
  <string name="companion_share_target">Send to TV</string>
  <!-- Main screen: heading while looking for TVs -->
  <string name="companion_pick_tv">Pick your TV</string>
  <!-- Main screen: hint while no TV is found -->
  <string name="companion_searching">Looking for TVs… Open TV Marketplace on the TV and keep the phone on the same Wi-Fi.</string>
  <!-- Main screen: hint above the code field. %1$s is the TV name -->
  <string name="companion_enter_pin">Open “Add app” on %1$s and enter the code shown there.</string>
  <!-- Main screen: label of the code field -->
  <string name="companion_pin">Code</string>
  <!-- Main screen: button that pairs with the TV -->
  <string name="companion_pair">Pair</string>
  <!-- Main screen: wrong code. %1$d is how many attempts are left -->
  <string name="companion_wrong_pin">Wrong code. Attempts left: %1$d.</string>
  <!-- Main screen: the Add app screen isn't open on the TV -->
  <string name="companion_no_session">Open “Add app” on the TV first.</string>
  <!-- Main screen: after pairing. %1$s is the TV name -->
  <string name="companion_paired">Paired with %1$s. Share a GitHub link and choose Send to TV.</string>
  <!-- Main screen: button that forgets the paired TV -->
  <string name="companion_forget">Forget this TV</string>
  <!-- Share: link sent -->
  <string name="companion_sent">Sent to your TV</string>
  <!-- Share: link sent, the app is already on the TV -->
  <string name="companion_sent_duplicate">Sent. This app is already on your TV.</string>
  <!-- Share: not a GitHub link -->
  <string name="companion_unsupported">Only GitHub links are supported for now</string>
  <!-- Share: TV not found or not reachable -->
  <string name="companion_unreachable">TV not found. Is TV Marketplace open and on the same Wi-Fi?</string>
  <!-- Share: the TV forgot this phone -->
  <string name="companion_revoked">The TV forgot this phone. Pair it again.</string>
  <!-- Share: no TV paired yet -->
  <string name="companion_not_paired">Pair with your TV first</string>
</resources>
